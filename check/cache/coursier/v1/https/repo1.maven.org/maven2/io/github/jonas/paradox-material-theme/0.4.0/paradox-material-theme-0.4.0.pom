<?xml version='1.0' encoding='UTF-8'?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.jonas</groupId>
    <artifactId>paradox-material-theme</artifactId>
    <packaging>jar</packaging>
    <description>Material Design theme for Paradox</description>
    <url>https://jonas.github.io/paradox-material-theme</url>
    <version>0.4.0</version>
    <licenses>
        <license>
            <name>MIT</name>
            <url>https://github.com/jonas/paradox-material-theme/blob/master/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <name>paradox-material-theme</name>
    <organization>
        <name>io.github.jonas</name>
        <url>https://jonas.github.io/paradox-material-theme</url>
    </organization>
    <scm>
        <url>https://github.com/jonas/paradox-material-theme</url>
        <connection>scm:git:git@github.com:jonas/paradox-material-theme.git</connection>
    </scm>
    <developers>
        <developer>
            <id>jonas</id>
            <name>Jonas Fonseca</name>
            <email>jonas.fonseca@gmail.com</email>
            <url>https://github.com/jonas</url>
        </developer>
    </developers>
    <dependencies>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>prettify</artifactId>
            <version>4-Mar-2013-1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>modernizr</artifactId>
            <version>2.8.3</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>material__tabs</artifactId>
            <version>0.3.1</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>material__animation</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>material__base</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>material__ripple</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>material__rtl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>material__theme</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>material__typography</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>