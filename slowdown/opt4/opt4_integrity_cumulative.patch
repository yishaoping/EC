diff --git a/chipyard/generators/boom/src/main/scala/lsu/speculative-version-buffer.scala b/chipyard/generators/boom/src/main/scala/lsu/speculative-version-buffer.scala
new file mode 100644
index 000000000..42f0b0be8
--- /dev/null
+++ b/chipyard/generators/boom/src/main/scala/lsu/speculative-version-buffer.scala
@@ -0,0 +1,418 @@
+package boom.lsu
+
+import chisel3._
+import chisel3.util._
+
+import org.chipsalliance.cde.config.{Field, Parameters}
+import freechips.rocketchip.diplomacy._
+import freechips.rocketchip.rocket._
+import freechips.rocketchip.tilelink._
+import freechips.rocketchip.util.{CacheOpportunityObservation, SafeChainObservation}
+import freechips.rocketchip.guardiancouncil.GH_GlobalParams
+import boom.common._
+
+/** Storage capacity only; cache geometry and version semantics are unchanged. */
+case object SVBEntries extends Field[Int](16)
+
+/** The complete image handed from the L1 line reader to the SVB. */
+class SpeculativeVersionSnapshot(val rows: Int, val rowBits: Int)(implicit p: Parameters)
+    extends BoomBundle()(p) {
+  val line = UInt(coreMaxAddrBits.W)
+  val key = new CacheImageKey
+  val epoch = UInt(16.W)
+  val param = UInt(TLPermissions.cWidth.W)
+  val data = Vec(rows, UInt(rowBits.W))
+}
+
+/** A full immutable snapshot plus its SVB slot identity. */
+class SpeculativeVersionPromotion(rows: Int, rowBits: Int, entryBits: Int)(implicit p: Parameters)
+    extends SpeculativeVersionSnapshot(rows, rowBits)(p) {
+  val entry = UInt(entryBits.W)
+}
+
+class SpeculativeVersionCompletion(entryBits: Int)(implicit p: Parameters) extends BoomBundle()(p) {
+  val entry = UInt(entryBits.W)
+  val key = new CacheImageKey
+}
+
+/**
+  * A bounded, global associative buffer for the one case in which the old
+  * L1 image is an unsafe predecessor of a younger same-line store.
+  *
+  * Entries never participate in ordinary L1 load selection.  A watermark
+  * classifies them safe; the largest safe package sequence is selected for
+  * promotion.  The entry remains valid through every C beat and until the
+  * matching ReleaseAck, so it remains a recovery source during WB_WAIT.
+  */
+class SpeculativeVersionBuffer(val entries: Int)
+    (implicit edge: TLEdgeOut, p: Parameters)
+    extends L1HellaCacheModule()(p) {
+  require(entries > 0 && (entries & (entries - 1)) == 0,
+    "SVB entry count must be a power of two")
+
+  val io = IO(new Bundle {
+    val capture = Flipped(Decoupled(new SpeculativeVersionSnapshot(refillCycles, encRowBits)))
+    val safeWatermark = Input(UInt(GH_GlobalParams.GH_PACKET_SEQ_BITS.W))
+    val currentEpoch = Input(UInt(16.W))
+    val diagnosticDump = Input(Bool())
+    val diagnosticCycle = Input(UInt(64.W))
+    val resetStats = Input(Bool())
+    val countStats = Input(Bool())
+    val invalidate = Input(Valid(UInt(GH_GlobalParams.GH_PACKET_SEQ_BITS.W)))
+    val flush = Input(Bool())
+    val promote = Decoupled(new SpeculativeVersionPromotion(refillCycles, encRowBits, log2Ceil(entries)))
+    val selected = Output(Bool())
+    val activeEntry = Output(UInt(log2Ceil(entries).W))
+    val activeLine = Output(UInt(coreMaxAddrBits.W))
+    val activeKey = Output(new CacheImageKey)
+    val queued = Output(UInt(log2Ceil(entries + 1).W))
+    val coalesced = Output(UInt(log2Ceil(entries + 1).W))
+    val discarded = Output(UInt(log2Ceil(entries + 1).W))
+    // A younger normal release/probe must not publish ahead of any retained
+    // predecessor. Include WB_WAIT until its matching completion, not C.last.
+    val releaseLines = Input(Vec(4, UInt(coreMaxAddrBits.W)))
+    val releaseBlocked = Output(Vec(4, Bool()))
+    val releaseBlockingEntry = Output(Vec(4, UInt(log2Ceil(entries).W)))
+    val releaseBlockingLine = Output(Vec(4, UInt(coreMaxAddrBits.W)))
+    val releaseBlockingSeq = Output(Vec(4, UInt(GH_GlobalParams.GH_PACKET_SEQ_BITS.W)))
+    val releaseBlockingGeneration = Output(Vec(4, UInt(32.W)))
+    val ack = Input(Valid(new SpeculativeVersionCompletion(log2Ceil(entries))))
+    val occupancy = Output(UInt(log2Ceil(entries + 1).W))
+    val maxOccupancy = Output(UInt(log2Ceil(entries + 1).W))
+    val maxDepth = Output(UInt(log2Ceil(entries + 1).W))
+    val depth = Output(UInt(log2Ceil(entries + 1).W))
+    val occupancyHistogram = Output(Vec(entries + 1, UInt(64.W)))
+    val depthHistogram = Output(Vec(entries + 1, UInt(64.W)))
+    // Observation identity only; never participates in allocation or arbitration.
+    val observationSerial = Output(UInt(64.W))
+    val allocation = Output(Bool())
+    val allocatedEntry = Output(UInt(log2Ceil(entries).W))
+    val entryAccounting = Output(Vec(5, UInt(64.W)))
+    val fullFallback = Output(Bool())
+    val promotion = Output(Bool())
+    val acked = Output(Bool())
+    val recoveryFromSvb = Output(Bool())
+  })
+
+  private val stFree = 0.U(2.W)
+  private val stSpec = 1.U(2.W)
+  private val stWb = 2.U(2.W)
+
+  val valid = RegInit(VecInit(Seq.fill(entries)(false.B)))
+  val state = RegInit(VecInit(Seq.fill(entries)(stFree)))
+  val line = Reg(Vec(entries, UInt(coreMaxAddrBits.W)))
+  val key = Reg(Vec(entries, new CacheImageKey))
+  val epoch = Reg(Vec(entries, UInt(16.W)))
+  val param = Reg(Vec(entries, UInt(TLPermissions.cWidth.W)))
+  val data = Reg(Vec(entries, Vec(refillCycles, UInt(encRowBits.W))))
+  val active = RegInit(false.B)
+  val activeIdx = Reg(UInt(log2Ceil(entries).W))
+  val sent = RegInit(false.B)
+
+  val freeVec = VecInit((0 until entries).map(i => !valid(i)))
+  for (q <- 0 until 4) {
+    val blockedByEntry = VecInit((0 until entries).map(i => valid(i) && line(i) === io.releaseLines(q)))
+    io.releaseBlocked(q) := blockedByEntry.asUInt.orR
+    io.releaseBlockingEntry(q) := PriorityEncoder(blockedByEntry.asUInt)
+    io.releaseBlockingLine(q) := Mux(io.releaseBlocked(q), line(io.releaseBlockingEntry(q)), 0.U)
+    io.releaseBlockingSeq(q) := Mux(io.releaseBlocked(q), key(io.releaseBlockingEntry(q)).contentSeq, 0.U)
+    io.releaseBlockingGeneration(q) := Mux(io.releaseBlocked(q), key(io.releaseBlockingEntry(q)).generation, 0.U)
+  }
+  val freeAny = freeVec.asUInt.orR
+  val allocOH = PriorityEncoderOH(freeVec.asUInt)
+  io.capture.ready := freeAny && !io.flush
+
+  val entrySafe = VecInit((0 until entries).map(i =>
+    valid(i) && state(i) === stSpec && epoch(i) === io.currentEpoch &&
+      (!key(i).valid || key(i).contentSeq === 0.U ||
+       key(i).contentSeq <= io.safeWatermark)))
+
+  val entryAge = RegInit(VecInit(Seq.fill(entries)(0.U(32.W))))
+  val entryAgeReported = RegInit(VecInit(Seq.fill(entries)(false.B)))
+  for (i <- 0 until entries) {
+    when (!valid(i)) {
+      entryAge(i) := 0.U
+      entryAgeReported(i) := false.B
+    }.otherwise {
+      when (entryAge(i) =/= ~0.U(32.W)) { entryAge(i) := entryAge(i) + 1.U }
+      when (entryAge(i) === 65535.U && !entryAgeReported(i)) {
+        val waitingReason = Mux(state(i) === stWb,
+          Mux(sent, 2.U, 1.U), Mux(entrySafe(i), 3.U, 4.U))
+        printf("LONG_STALL object=SVB_ENTRY cycle=%x age=%x entry=%x line=%x state=%x safe=%x active=%x promotion_eligible=%x seq=%x generation=%x waiting_reason=%x watermark=%x\n",
+          io.diagnosticCycle, entryAge(i), i.U, line(i), state(i), entrySafe(i),
+          active && activeIdx === i.U, entrySafe(i) && !active,
+          key(i).contentSeq, key(i).generation, waitingReason, io.safeWatermark)
+        entryAgeReported(i) := true.B
+      }
+    }
+  }
+
+  for (i <- 0 until entries) {
+    val wasSafe = RegNext(entrySafe(i), false.B)
+    when (entrySafe(i) && !wasSafe) {
+      printf("SVB_SAFE cycle=%x entry=%x line=%x seq=%x generation=%x epoch=%x watermark=%x\n",
+        io.diagnosticCycle, i.U, line(i), key(i).contentSeq, key(i).generation,
+        epoch(i), io.safeWatermark)
+    }
+  }
+
+  when (io.diagnosticDump) {
+    for (i <- 0 until entries) {
+      when (valid(i)) {
+        printf("SVB_HANG_ENTRY cycle=%x entry=%x state=%x active=%x line=%x seq=%x generation=%x writer=%x key_valid=%x epoch=%x\n",
+          io.diagnosticCycle, i.U, state(i), active && activeIdx === i.U,
+          line(i), key(i).contentSeq, key(i).generation, key(i).writer,
+          key(i).valid, epoch(i))
+      }
+    }
+  }
+
+  // Compare every candidate; equal-package versions on the same line are
+  // ordered by the immutable writer generation, never by reusable slot ID.
+  // This also prevents selection of an entry coalesced in this same cycle.
+  val chooseValid = WireDefault(false.B)
+  val chooseIdx = WireDefault(0.U(log2Ceil(entries).W))
+  for (i <- 0 until entries) {
+    val noNewer = (0 until entries).filter(_ != i).map(j =>
+      !(entrySafe(j) && (key(j).contentSeq > key(i).contentSeq ||
+        (key(j).contentSeq === key(i).contentSeq &&
+          (key(j).generation > key(i).generation ||
+           (key(j).generation === key(i).generation && (j > i).B)))))).reduce(_ && _)
+    when (entrySafe(i) && noNewer) {
+      chooseValid := true.B
+      chooseIdx := i.U
+    }
+  }
+
+  val occupancyValue = PopCount(valid)
+  io.occupancy := occupancyValue
+  val maxOccupancyReg = RegInit(0.U(log2Ceil(entries + 1).W))
+  val maxDepthReg = RegInit(0.U(log2Ceil(entries + 1).W))
+  when (io.resetStats) {
+    maxOccupancyReg := 0.U
+    maxDepthReg := 0.U
+  }.elsewhen (io.countStats && occupancyValue > maxOccupancyReg) {
+    maxOccupancyReg := occupancyValue
+  }
+  io.maxOccupancy := maxOccupancyReg
+
+  val lineDepth = VecInit((0 until entries).map(i =>
+    PopCount((0 until entries).map(j => valid(j) && line(j) === line(i)))))
+  val depthValue = Mux(valid.asUInt.orR, lineDepth.reduce((a, b) => Mux(a > b, a, b)), 0.U)
+  io.depth := depthValue
+  when (!io.resetStats && io.countStats && depthValue > maxDepthReg) { maxDepthReg := depthValue }
+  io.maxDepth := maxDepthReg
+
+  val occupancyHistogramReg = RegInit(VecInit(Seq.fill(entries + 1)(0.U(64.W))))
+  val depthHistogramReg = RegInit(VecInit(Seq.fill(entries + 1)(0.U(64.W))))
+  when (io.resetStats) {
+    for (i <- 0 to entries) {
+      occupancyHistogramReg(i) := 0.U
+      depthHistogramReg(i) := 0.U
+    }
+  }.elsewhen (io.countStats && occupancyHistogramReg(occupancyValue) =/= ~0.U(64.W)) {
+    occupancyHistogramReg(occupancyValue) := occupancyHistogramReg(occupancyValue) + 1.U
+  }
+  when (!io.resetStats && io.countStats && depthHistogramReg(depthValue) =/= ~0.U(64.W)) {
+    depthHistogramReg(depthValue) := depthHistogramReg(depthValue) + 1.U
+  }
+  io.occupancyHistogram := occupancyHistogramReg
+  io.depthHistogram := depthHistogramReg
+
+  // Once selected, hold both entry and payload through arbitration and ACK.
+  // Flush/coalescing may only discard SPEC entries, never this WB_WAIT owner.
+  io.selected := !active && chooseValid && !io.flush && !io.invalidate.valid
+  io.activeEntry := Mux(io.selected, chooseIdx, activeIdx)
+  io.activeLine := line(io.activeEntry)
+  io.activeKey := key(io.activeEntry)
+  io.queued := PopCount(entrySafe) + (active && !sent).asUInt
+  io.promote.valid := active && !sent
+  io.promote.bits.entry := activeIdx
+  io.promote.bits.line := line(activeIdx)
+  io.promote.bits.key := key(activeIdx)
+  io.promote.bits.epoch := epoch(activeIdx)
+  io.promote.bits.param := param(activeIdx)
+  io.promote.bits.data := data(activeIdx)
+  io.allocation := io.capture.fire
+  io.allocatedEntry := PriorityEncoder(freeVec.asUInt)
+  io.fullFallback := !io.capture.ready && io.capture.valid
+  io.promotion := io.promote.fire
+  io.acked := io.ack.valid && active && sent &&
+    io.ack.bits.entry === activeIdx && io.ack.bits.key.asUInt === key(activeIdx).asUInt
+  io.recoveryFromSvb := io.acked
+  when (io.ack.valid) {
+    assert(io.acked, "SVB completion does not match the outstanding entry/key")
+  }
+
+  when (io.capture.fire) {
+    for (i <- 0 until entries) {
+      when (allocOH(i)) {
+        valid(i) := true.B
+        state(i) := stSpec
+        line(i) := io.capture.bits.line
+        key(i) := io.capture.bits.key
+        epoch(i) := io.capture.bits.epoch
+        param(i) := io.capture.bits.param
+        data(i) := io.capture.bits.data
+        printf("SVB_ENTRY_ALLOC cycle=%x entry=%x line=%x seq=%x generation=%x epoch=%x state=SPEC\n",
+          io.diagnosticCycle, i.U, io.capture.bits.line, io.capture.bits.key.contentSeq,
+          io.capture.bits.key.generation, io.capture.bits.epoch)
+      }
+    }
+  }
+
+  when (io.selected) {
+    assert(valid(chooseIdx) && state(chooseIdx) === stSpec,
+      "SVB scheduler reselected WB_WAIT or invalid entry")
+    assert(epoch(chooseIdx) === io.currentEpoch,
+      "SVB selected a stale-epoch entry")
+    active := true.B
+    activeIdx := chooseIdx
+    sent := false.B
+    state(chooseIdx) := stWb
+    printf("SVB_PROMOTION_SELECT cycle=%x entry=%x line=%x seq=%x generation=%x state=WB_WAIT safe=%x\n",
+      io.diagnosticCycle, chooseIdx, line(chooseIdx), key(chooseIdx).contentSeq,
+      key(chooseIdx).generation, entrySafe(chooseIdx))
+  }
+  // A complete newer safe image supersedes an older safe image on the same
+  // line.  WB entries are deliberately excluded: until their ACK they still
+  // own a valid lower-level recovery copy.
+  val coalesce = VecInit((0 until entries).map(i => entrySafe(i) &&
+    (0 until entries).map(j => entrySafe(j) && line(i) === line(j) &&
+      key(i).writer === key(j).writer &&
+      (key(i).contentSeq < key(j).contentSeq ||
+       (key(i).contentSeq === key(j).contentSeq &&
+        key(i).generation < key(j).generation))).reduce(_ || _)))
+  io.coalesced := PopCount(coalesce)
+  io.discarded := PopCount((0 until entries).map(i => valid(i) && state(i) === stSpec &&
+    !coalesce(i) && (io.flush || (io.invalidate.valid && key(i).valid &&
+      key(i).contentSeq > io.invalidate.bits))))
+  for (i <- 0 until entries) {
+    when (coalesce(i)) {
+      valid(i) := false.B
+      state(i) := stFree
+    }
+  }
+  when (io.promote.fire) {
+    assert(active && !sent && valid(activeIdx) && state(activeIdx) === stWb,
+      "SVB duplicate promotion or missing WB_WAIT owner")
+    sent := true.B
+  }
+
+  when (io.acked) {
+    printf("SVB_COMPLETION cycle=%x entry=%x line=%x seq=%x generation=%x state=FREE\n",
+      io.diagnosticCycle, activeIdx, line(activeIdx), key(activeIdx).contentSeq,
+      key(activeIdx).generation)
+    valid(activeIdx) := false.B
+    state(activeIdx) := stFree
+    sent := false.B
+    active := false.B
+  }
+
+  // A failed/cancelled package invalidates versions newer than the current
+  // safe watermark. Safe predecessors remain available for recovery and
+  // promotion; a WB entry is retained until its ACK in all cases.
+  when (io.invalidate.valid) {
+    for (i <- 0 until entries) {
+      when (valid(i) && state(i) === stSpec &&
+        key(i).valid && key(i).contentSeq > io.invalidate.bits) {
+        valid(i) := false.B
+        state(i) := stFree
+      }
+    }
+  }
+  when (io.flush) {
+    for (i <- 0 until entries) {
+      when (state(i) === stSpec) {
+        valid(i) := false.B
+        state(i) := stFree
+      }
+    }
+  }
+
+  // Simulation evidence is keyed by allocation serial, never reusable slot/key.
+  val observationSerialCounter = RegInit(0.U(64.W))
+  val observationSerials = Reg(Vec(entries, UInt(64.W)))
+  when (io.capture.fire) {
+    observationSerialCounter := observationSerialCounter + 1.U
+    observationSerials(io.allocatedEntry) := observationSerialCounter + 1.U
+  }
+  io.observationSerial := observationSerials(activeIdx)
+  def integrityEvent(kind: Int, event: Bool, fields: Seq[UInt], lane: UInt = 0.U): Unit =
+    SafeChainObservation.emit(kind, clock, reset.asBool, io.diagnosticCycle,
+      io.diagnosticCycle, lane, true.B, event, fields, 0.U, true.B)
+  val captureHash = CacheOpportunityObservation.lineHash(io.capture.bits.data.toSeq, encRowBits)
+  integrityEvent(32, io.capture.fire, Seq(2.U, observationSerialCounter + 1.U,
+    io.allocatedEntry, io.capture.bits.line, io.capture.bits.key.contentSeq,
+    io.capture.bits.key.generation, io.capture.bits.key.writer, io.capture.bits.epoch,
+    io.capture.bits.key.valid.asUInt, captureHash, (refillCycles * encRowBits / 64).U))
+  val capturedPrevious = RegNext(io.capture.fire, false.B)
+  val capturedIndex = RegEnable(io.allocatedEntry, io.capture.fire)
+  integrityEvent(33, capturedPrevious, Seq(2.U, observationSerials(capturedIndex),
+    capturedIndex, CacheOpportunityObservation.lineHash(data(capturedIndex).toSeq, encRowBits)))
+  integrityEvent(34, io.promote.fire, Seq(2.U, observationSerials(activeIdx), activeIdx,
+    CacheOpportunityObservation.lineHash(data(activeIdx).toSeq, encRowBits),
+    CacheOpportunityObservation.lineHash(io.promote.bits.data.toSeq, encRowBits)))
+  for (i <- 0 until entries) {
+    val discard = valid(i) && state(i) === stSpec && !coalesce(i) &&
+      (io.flush || (io.invalidate.valid && key(i).valid && key(i).contentSeq > io.invalidate.bits))
+    val complete = io.acked && activeIdx === i.U
+    val terminal = coalesce(i) || discard || complete
+    val successor = PriorityEncoder(VecInit((0 until entries).map(j =>
+      entrySafe(j) && line(j) === line(i) && key(j).writer === key(i).writer &&
+      (key(j).contentSeq > key(i).contentSeq ||
+       (key(j).contentSeq === key(i).contentSeq && key(j).generation > key(i).generation)))).asUInt)
+    integrityEvent(35, terminal, Seq(2.U, observationSerials(i), i.U,
+      Mux(complete, 1.U, Mux(coalesce(i), 2.U, Mux(io.flush, 3.U, 4.U))),
+      Mux(coalesce(i), observationSerials(successor), 0.U)), i.U)
+    val safePrevious = RegNext(entrySafe(i), false.B)
+    val serialPrevious = RegNext(observationSerials(i))
+    integrityEvent(36, entrySafe(i) && (!safePrevious || serialPrevious =/= observationSerials(i)),
+      Seq(2.U, observationSerials(i), i.U, io.safeWatermark), i.U)
+    val retainedImage = RegNext(valid(i) && !terminal, false.B)
+    val previousImage = RegNext(Cat(line(i), key(i).asUInt, epoch(i), param(i), data(i).asUInt))
+    when (retainedImage) {
+      assert(valid(i) && Cat(line(i), key(i).asUInt, epoch(i), param(i), data(i).asUInt) === previousImage,
+        "INTEGRITY-1: retained SVB snapshot changed before terminal event")
+    }
+  }
+  // Atomic next-state accounting includes every terminal on the same edge.
+  val observationDeleted = io.coalesced +& io.discarded +& io.acked.asUInt
+  val observationNextOccupancy = occupancyValue +& io.capture.fire.asUInt - observationDeleted
+  val observationExpectedOccupancy = RegNext(observationNextOccupancy)
+  when (RegNext(!reset.asBool, false.B)) {
+    assert(occupancyValue === observationExpectedOccupancy, "INTEGRITY-2: simultaneous occupancy accounting")
+  }
+
+  // Full-run conservation, independent of RESET/START/STOP measurement bits.
+  // Capture and deletion are disjoint by slot; WB_WAIT is never discarded.
+  val totalAllocated = RegInit(0.U(64.W))
+  val totalCompleted = RegInit(0.U(64.W))
+  val totalCoalesced = RegInit(0.U(64.W))
+  val totalDiscarded = RegInit(0.U(64.W))
+  when (io.capture.fire) { totalAllocated := totalAllocated + 1.U }
+  when (io.acked) { totalCompleted := totalCompleted + 1.U }
+  totalCoalesced := totalCoalesced + io.coalesced
+  totalDiscarded := totalDiscarded + io.discarded
+  io.entryAccounting := VecInit(Seq(totalAllocated, totalCompleted, totalCoalesced,
+    totalDiscarded, occupancyValue.pad(64)))
+  assert(totalAllocated === totalCompleted + totalCoalesced + totalDiscarded + occupancyValue,
+    "SVB entry conservation failed")
+
+  assert(PopCount((0 until entries).map(i => valid(i) && state(i) === stWb)) <= 1.U,
+    "SVB has multiple outstanding promotions")
+  when (active) {
+    assert(valid(activeIdx) && state(activeIdx) === stWb, "SVB lost WB_WAIT owner before ACK")
+  }
+  for (i <- 0 until entries) {
+    val retained = RegNext(valid(i) && state(i) === stWb &&
+      !(io.acked && activeIdx === i.U), false.B)
+    val heldImage = RegNext(Cat(line(i), key(i).asUInt, epoch(i), param(i), data(i).asUInt))
+    when (retained) {
+      assert(valid(i) && state(i) === stWb, "SVB freed WB_WAIT without matching ACK")
+      assert(Cat(line(i), key(i).asUInt, epoch(i), param(i), data(i).asUInt) === heldImage,
+        "SVB mutated WB_WAIT snapshot")
+    }
+  }
+  assert(!(io.capture.fire && !freeAny), "SVB overwrite while all entries valid")
+}
diff --git a/chipyard/generators/rocket-chip/src/main/resources/csrc/cache_opportunity.cc b/chipyard/generators/rocket-chip/src/main/resources/csrc/cache_opportunity.cc
new file mode 100644
index 000000000..3341225ac
--- /dev/null
+++ b/chipyard/generators/rocket-chip/src/main/resources/csrc/cache_opportunity.cc
@@ -0,0 +1,261 @@
+// Observation-only host models. No Verilator/RTL state is ever written here.
+// Input stream and policy limits are emitted with every final summary.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <tuple>
+#include <unordered_set>
+#include <vector>
+
+namespace ec_observation {
+using U = unsigned long long;
+struct Counts { U access=0, hit=0, miss=0, replacement=0, dirty_victim=0, set_full_miss=0; };
+struct Tag {
+  U line; bool valid, dirty;
+  Tag(U l=0,bool v=false,bool d=false):line(l),valid(v),dirty(d) {}
+};
+static U rotate(U x, unsigned n) { n%=64; return n ? (x<<n)|(x>>(64-n)) : x; }
+
+struct Shadow {
+  unsigned sets, ways, block; int level; uint16_t random=1;
+  std::vector<Tag> tags; Counts c;
+  Shadow(unsigned s,unsigned w,unsigned b,int l):sets(s),ways(w),block(b),level(l),tags(s*w) {}
+  void access(U address,bool write,bool count,bool allocate=true,bool countFill=false) {
+    U line=address/block; unsigned set=line%sets;
+    if(count) ++c.access;
+    for(unsigned w=0;w<ways;++w) { auto &t=tags[set*ways+w];
+      if(t.valid && t.line==line) { if(count) ++c.hit; t.dirty|=write; return; }
+    }
+    if(count) ++c.miss;
+    if(count) {
+      bool full=true;
+      for(unsigned w=0;w<ways;++w) full &= tags[set*ways+w].valid;
+      c.set_full_miss+=full;
+    }
+    if(!allocate) return;
+    // Same random-replacement family as both real caches. Advance on this
+    // model's misses; this is intentionally not a cycle-exact RTL LFSR replay.
+    unsigned bits=level==2 ? (random&1023u) : random;
+    unsigned victim=(static_cast<U>(bits)*ways)/(level==2 ? 1024u:65536u);
+    auto &t=tags[set*ways+victim];
+    if((count || countFill) && t.valid) { ++c.replacement; c.dirty_victim+=t.dirty; }
+    t={line,true,write};
+    unsigned feedback=((random>>0)^(random>>2)^(random>>3)^(random>>5))&1;
+    random=static_cast<uint16_t>((random>>1)|(feedback<<15));
+  }
+  void invalidate(U address) {
+    U line=address/block; unsigned set=line%sets;
+    for(unsigned w=0;w<ways;++w) if(tags[set*ways+w].line==line) tags[set*ways+w].valid=false;
+  }
+};
+
+// Hash checking lives in the allocation-scoped SC schema2 ledger. Keeping a
+// global (line,generation,writer) XOR here merged legal repeated transactions.
+static std::string data_summary() {
+  return "{\"schema\":2,\"status\":\"SC_LIFECYCLE_LEDGER_REQUIRED\"}";
+}
+
+struct Cache {
+  int level,id; unsigned sets,ways,block,mshrs;
+  bool enabled=false,seen_clear=false,seen_reset=false,finished=false,stop_seen=false;
+  U cycle=0,cycles=0,loads=0,stores=0,permission_miss=0,request_a=0,request_c=0;
+  U compulsory_like=0,set_full=0,set_conflict_replacements=0,repeated_set_miss=0,repeated_line_miss=0;
+  U probe_evictions=0,svb_full=0,svb_unsupported=0,writebacks=0;
+  U memory_reads=0,memory_writes=0,memory_read_bytes=0,memory_write_bytes=0,mshr_full_cycles=0;
+  U metadata_replacements=0,metadata_invalidations=0,dirty_metadata_retirements=0;
+  Counts actual;
+  U svb_allocated=0,svb_completed=0,svb_coalesced=0,svb_discarded=0,svb_occupancy=0;
+  U would_full_at_8=0,cycles_above_8=0,capture_failures=0,max_svb_occupancy=0,max_svb_depth=0;
+  unsigned svb_entries=0; bool svb_frame=false,capacity_frame=false;
+  std::vector<Shadow> models;
+  std::vector<Tag> mirror;
+  std::vector<U> valid_hist, mshr_hist, set_access, set_miss, set_full_hist, last_miss;
+  std::vector<U> svb_occupancy_hist,svb_depth_hist;
+  std::vector<bool> had_miss;
+  std::unordered_set<U> tokens,seen_lines;
+  Cache(int l,int i,unsigned s,unsigned w,unsigned b,unsigned m):
+    level(l),id(i),sets(s),ways(w),block(b),mshrs(m),mirror(s*w),
+    valid_hist(w+1),mshr_hist(m+1),set_access(s),set_miss(s),set_full_hist(s),last_miss(s),had_miss(s) {
+    models.emplace_back(s,w,b,l);
+    if(s>=2) models.emplace_back(s/2,w*2,b,l);
+    models.emplace_back(s*2,w,b,l);
+    models.emplace_back(s,w*2,b,l);
+  }
+  void clear_stats() {
+    cycles=loads=stores=permission_miss=request_a=request_c=compulsory_like=set_full=set_conflict_replacements=0;
+    repeated_set_miss=repeated_line_miss=probe_evictions=svb_full=svb_unsupported=writebacks=0;
+    memory_reads=memory_writes=memory_read_bytes=memory_write_bytes=mshr_full_cycles=0;
+    metadata_replacements=metadata_invalidations=dirty_metadata_retirements=0; actual={};
+    for(auto &m:models) m.c={};
+    for(auto *v:{&valid_hist,&mshr_hist,&set_access,&set_miss,&set_full_hist}) std::fill(v->begin(),v->end(),0);
+    svb_occupancy_hist.clear(); svb_depth_hist.clear();
+    std::fill(had_miss.begin(),had_miss.end(),false); stop_seen=false;
+  }
+  void event(int kind,unsigned flags,U address,U tag,U value,unsigned set,unsigned way,unsigned occupancy) {
+    if(kind>=20 && kind<=22) return; // legacy identity is intentionally not trusted
+    if(kind==30) { svb_frame=true; svb_entries=flags; svb_coalesced=address;
+      svb_allocated=tag; svb_completed=value; svb_discarded=set; svb_occupancy=way; max_svb_depth=occupancy; return; }
+    if(kind==31) { capacity_frame=true; would_full_at_8=address; cycles_above_8=tag;
+      capture_failures=value; max_svb_occupancy=set; return; }
+    if(kind==32) {
+      if(svb_occupancy_hist.empty()) { svb_occupancy_hist.resize(flags+1); svb_depth_hist.resize(flags+1); }
+      if(enabled && way<svb_occupancy_hist.size() && occupancy<svb_depth_hist.size()) {
+        ++svb_occupancy_hist[way]; ++svb_depth_hist[occupancy];
+      }
+      return;
+    }
+    if(kind==1) {
+      if(level==1 && !tokens.insert(tag).second) return; // one first lookup per request token
+      bool fresh=seen_lines.insert(address/block).second;
+      // S0 independently replays real metadata writes instead of installing on
+      // first lookup, which incorrectly turned in-flight misses into hits.
+      bool s0_hit=false;
+      for(unsigned w=0;w<ways;++w) {
+        const auto &t=mirror[set*ways+w]; s0_hit |= t.valid && t.line==address;
+      }
+      if(enabled) { ++models[0].c.access; models[0].c.hit+=s0_hit; models[0].c.miss+=!s0_hit; }
+      for(size_t i=1;i<models.size();++i) models[i].access(address,flags&2,enabled,!(flags&8));
+      if(!enabled) return;
+      ++actual.access; actual.hit+=(flags&4)!=0; actual.miss+=(flags&8)!=0;
+      loads+=(flags&1)!=0; stores+=(flags&2)!=0; permission_miss+=(flags&16)!=0;
+      if(occupancy<valid_hist.size()) ++valid_hist[occupancy];
+      if(set<sets) { ++set_access[set]; if(flags&8) {
+        ++set_miss[set]; compulsory_like+=fresh;
+        if(occupancy==ways) { ++set_full; ++set_full_hist[set]; ++actual.set_full_miss; }
+        if(had_miss[set]) { ++repeated_set_miss; repeated_line_miss+=last_miss[set]==address; }
+        had_miss[set]=true; last_miss[set]=address;
+      }}
+    } else if(kind==5) {
+      if(set>=sets || way>=ways) return;
+      auto &t=mirror[set*ways+way]; bool valid=flags&1;
+      if(enabled && t.valid && (!valid || t.line!=address)) {
+        metadata_invalidations+=!valid; metadata_replacements+=valid;
+        dirty_metadata_retirements+=t.dirty;
+        if(valid) { ++models[0].c.replacement; models[0].c.dirty_victim+=t.dirty; }
+      }
+      t={address,valid,(flags&2)!=0};
+      if(valid) for(size_t i=1;i<models.size();++i) models[i].access(address,flags&2,false,true,enabled);
+    } else if(kind==3) {
+      for(size_t i=1;i<models.size();++i) models[i].invalidate(address);
+      if(enabled) ++probe_evictions;
+    } else if(kind==12) { // ReleaseData can install L2 data without an A demand
+      for(size_t i=1;i<models.size();++i) models[i].access(address,true,false,true,enabled);
+      // No demand miss/replacement credit for silent fills.
+      for(auto &m:models) {
+        U line=address/block; unsigned s=line%m.sets;
+        for(unsigned w=0;w<m.ways;++w) { auto &t=m.tags[s*m.ways+w]; if(t.valid && t.line==line) t.dirty=true; }
+      }
+    } else if(enabled) {
+      switch(kind) {
+      case 2: {
+        ++actual.replacement; actual.dirty_victim+=(flags&1)!=0;
+        bool full=(flags&2)!=0;
+        if(level==2 && set<sets) {
+          full=true;
+          for(unsigned w=0;w<ways;++w) full &= mirror[set*ways+w].valid;
+        }
+        set_conflict_replacements+=full;
+        break;
+      }
+      case 3: ++probe_evictions; break;
+      case 4: svb_full+=(flags&1)!=0; svb_unsupported+=(flags&2)!=0; break;
+      case 6: request_a+=(flags&1)!=0; request_c+=(flags&2)!=0; break;
+      case 7: memory_reads+=(flags&1)!=0; memory_writes+=(flags&2)!=0;
+        if(flags&1) memory_read_bytes+=value;
+        if(flags&2) memory_write_bytes+=value;
+        break;
+      case 8: ++writebacks; break;
+      default: break;
+      }
+    }
+  }
+};
+static std::map<std::pair<int,int>,std::unique_ptr<Cache>> caches;
+static std::string counts(const Counts &c) {
+  std::ostringstream o; o<<"{\"access\":"<<c.access<<",\"hit\":"<<c.hit<<",\"miss\":"<<c.miss
+    <<",\"replacement\":"<<c.replacement<<",\"dirty_victim\":"<<c.dirty_victim
+    <<",\"set_full_miss\":"<<c.set_full_miss<<"}"; return o.str();
+}
+static std::string array(const std::vector<U> &v) {
+  std::ostringstream o; o<<'['; for(size_t i=0;i<v.size();++i) { if(i)o<<',';o<<v[i]; }o<<']';return o.str();
+}
+static void finish(Cache &c) {
+  if(c.finished || c.level==0) return;
+  c.finished=true;
+  U shadow_miss=c.models[0].c.miss,real_miss=c.actual.miss;
+  double gap=double(shadow_miss>real_miss ? shadow_miss-real_miss:real_miss-shadow_miss)/std::max<U>(real_miss,1);
+  bool sane=c.actual.access && gap<=0.10 && c.stop_seen;
+  std::ostringstream o;
+  o<<"{\"schema\":1,\"classification\":\"COUNTERFACTUAL_CACHE_TRAFFIC_ESTIMATE\",\"level\":"<<c.level
+   <<",\"instance\":"<<c.id<<",\"sets\":"<<c.sets<<",\"ways\":"<<c.ways<<",\"block_bytes\":"<<c.block
+   <<",\"mshrs\":"<<c.mshrs<<",\"stop_seen\":"<<(c.stop_seen?"true":"false")
+   <<",\"replacement_policy\":\"random\",\"shadow_policy\":\"metadata_replay_S0_deferred_fill_random_alternatives\""
+   <<",\"semantics\":\"L1_unique_first_S2_token_lookup_L2_A_directory_lookup_including_retries\""
+   <<",\"limitations\":\"no_timing_feedback_no_cycle_exact_replacement_metadata_fill_replay_no_cycle_exact_lookup_pipeline_no_predicted_ROI\""
+   <<",\"actual\":"<<counts(c.actual)<<",\"loads\":"<<c.loads<<",\"stores\":"<<c.stores
+   <<",\"permission_miss\":"<<c.permission_miss<<",\"request_a\":"<<c.request_a<<",\"request_c\":"<<c.request_c
+   <<",\"compulsory_like\":"<<c.compulsory_like<<",\"conflict_candidate\":"<<c.set_full
+   <<",\"set_full_events\":"<<c.set_full<<",\"same_set_repeated_miss\":"<<c.repeated_set_miss
+   <<",\"set_conflict_replacements\":"<<c.set_conflict_replacements
+   <<",\"same_line_repeated_miss\":"<<c.repeated_line_miss<<",\"probe_evictions\":"<<c.probe_evictions
+   <<",\"svb_full_fallback\":"<<c.svb_full<<",\"svb_unsupported_fallback\":"<<c.svb_unsupported
+   <<",\"writebacks\":"<<c.writebacks<<",\"dram_facing_reads\":"<<c.memory_reads
+   <<",\"dram_facing_writes\":"<<c.memory_writes<<",\"dram_facing_read_bytes\":"<<c.memory_read_bytes
+   <<",\"dram_facing_write_bytes\":"<<c.memory_write_bytes<<",\"metadata_tag_replacements\":"<<c.metadata_replacements
+   <<",\"metadata_invalidations\":"<<c.metadata_invalidations<<",\"dirty_metadata_retirements\":"<<c.dirty_metadata_retirements
+   <<",\"cycles\":"<<c.cycles<<",\"mshr_full_cycles\":"<<c.mshr_full_cycles
+   <<",\"ways_valid_histogram\":"<<array(c.valid_hist)<<",\"mshr_occupancy_histogram\":"<<array(c.mshr_hist)
+   <<",\"per_set_access\":"<<array(c.set_access)<<",\"per_set_miss\":"<<array(c.set_miss)
+   <<",\"per_set_full\":"<<array(c.set_full_hist)<<",\"s0_miss_relative_error\":"<<gap
+   <<",\"geometry_decision_eligible\":"<<(sane?"true":"false")<<",\"models\":[";
+  for(size_t i=0;i<c.models.size();++i) { const auto &m=c.models[i]; if(i)o<<',';
+    o<<"{\"name\":\"S"<<i<<"\",\"sets\":"<<m.sets<<",\"ways\":"<<m.ways
+     <<",\"capacity_bytes\":"<<U(m.sets)*m.ways*m.block<<",\"stats\":"<<counts(m.c)<<'}';
+  }
+  o<<"],\"data_fingerprints\":"<<data_summary()
+   <<",\"svb_entry_accounting\":{\"observed\":"<<(c.svb_frame?"true":"false")
+   <<",\"scope\":\"full_run_final\",\"entries\":"<<c.svb_entries
+   <<",\"allocations\":"<<c.svb_allocated<<",\"completions\":"<<c.svb_completed
+   <<",\"coalesced\":"<<c.svb_coalesced<<",\"discarded\":"<<c.svb_discarded
+   <<",\"occupancy\":"<<c.svb_occupancy
+   <<",\"conserved\":"<<(c.svb_allocated==c.svb_completed+c.svb_coalesced+c.svb_discarded+c.svb_occupancy?"true":"false")
+   <<"},\"shadow_8_capacity\":{\"observed\":"<<(c.capacity_frame?"true":"false")
+   <<",\"scope\":\"hardware_traffic_START_inclusive_STOP_exclusive\",\"would_full_at_8\":"<<c.would_full_at_8
+   <<",\"cycles_above_8\":"<<c.cycles_above_8<<",\"capture_failures\":"<<c.capture_failures
+   <<",\"max_occupancy\":"<<c.max_svb_occupancy<<",\"max_depth\":"<<c.max_svb_depth
+   <<",\"occupancy_histogram\":"<<array(c.svb_occupancy_hist)
+   <<",\"depth_histogram\":"<<array(c.svb_depth_hist)<<"}}";
+  std::fprintf(stderr,"CACHE_OPPORTUNITY %s\n",o.str().c_str());
+}
+} // namespace
+
+extern "C" void ec_cache_tick(int level,int id,int sets,int ways,int block_bytes,int mshrs,
+    int reset_model,int reset_stats,int enabled,int stopped,int occupied,int full,unsigned long long cycle) {
+  using namespace ec_observation;
+  auto key=std::make_pair(level,id); auto &p=caches[key];
+  if(!p) p.reset(new Cache(level,id,sets,ways,block_bytes,mshrs));
+  if(reset_model) {
+    if(!p->seen_reset) { p.reset(new Cache(level,id,sets,ways,block_bytes,mshrs)); p->seen_reset=true; }
+    p->enabled=false; return;
+  }
+  p->seen_reset=false;
+  if(reset_stats && !p->seen_clear) p->clear_stats();
+  p->seen_clear=reset_stats; p->enabled=enabled && !reset_stats; p->cycle=cycle;
+  p->stop_seen|=stopped;
+  if(p->enabled) { ++p->cycles; p->mshr_full_cycles+=full;
+    if(occupied>=0 && unsigned(occupied)<p->mshr_hist.size()) ++p->mshr_hist[occupied];
+  }
+}
+extern "C" void ec_cache_event(int level,int id,int kind,int flags,unsigned long long address,
+    unsigned long long tag,unsigned long long value,int set,int way,int occupancy) {
+  using namespace ec_observation; auto p=caches.find({level,id});
+  if(p!=caches.end()) p->second->event(kind,flags,address,tag,value,set,way,occupancy);
+}
+extern "C" void ec_cache_finish(int level,int id) {
+  using namespace ec_observation; auto p=caches.find({level,id}); if(p!=caches.end()) finish(*p->second);
+}
diff --git a/chipyard/generators/rocket-chip/src/main/resources/vsrc/CacheOpportunityObserver.sv b/chipyard/generators/rocket-chip/src/main/resources/vsrc/CacheOpportunityObserver.sv
new file mode 100644
index 000000000..574df6fd8
--- /dev/null
+++ b/chipyard/generators/rocket-chip/src/main/resources/vsrc/CacheOpportunityObserver.sv
@@ -0,0 +1,47 @@
+// OBSERVATION_ONLY: no outputs and no influence on hardware handshakes.
+`timescale 1ps/1ps
+module CacheOpportunityObserver #(
+  parameter integer LEVEL=1, SETS=1, WAYS=1, BLOCK_BYTES=64, MSHRS=1, PORTS=1
+) (
+  input clock, reset, clear, enable, stop,
+  input [31:0] instance_id, mshr_occupancy,
+  input [63:0] cycle,
+  input mshr_full,
+  input [PORTS-1:0] event_valid,
+  input [PORTS*8-1:0] event_kind,
+  input [PORTS*32-1:0] event_flags, event_set, event_way, event_occupancy,
+  input [PORTS*64-1:0] event_address, event_tag, event_value
+);
+  // synthesis translate_off
+`ifndef SYNTHESIS
+  import "DPI-C" function void ec_cache_tick(input int level, id, sets, ways, block_bytes, mshrs,
+    input int reset_model, reset_stats, enabled, stopped, occupied, full,
+    input longint unsigned cycle_count);
+  import "DPI-C" function void ec_cache_event(input int level, id, kind, flags,
+    input longint unsigned address, tag, value,
+    input int set_index, way, occupancy);
+  import "DPI-C" function void ec_cache_finish(input int level, id);
+  integer p;
+  reg enabled_by_plusarg;
+  initial enabled_by_plusarg = $test$plusargs("cache-opportunity");
+  always @(posedge clock) if (enabled_by_plusarg) begin
+    ec_cache_tick(LEVEL, instance_id, SETS, WAYS, BLOCK_BYTES, MSHRS,
+      int'(reset), int'(clear), int'(enable), int'(stop), mshr_occupancy, int'(mshr_full), cycle);
+    if (!reset && !clear) for (p=0; p<PORTS; p=p+1) if (event_valid[p])
+      ec_cache_event(LEVEL, instance_id, int'(event_kind[p*8+:8]), event_flags[p*32+:32],
+        event_address[p*64+:64], event_tag[p*64+:64], event_value[p*64+:64],
+        event_set[p*32+:32], event_way[p*32+:32], event_occupancy[p*32+:32]);
+  end
+  final if (enabled_by_plusarg) begin
+    // Final register snapshots, even when STOP precedes the simulator exit.
+    // Other events are never replayed in final (that would double-count).
+    for (p=0; p<PORTS; p=p+1)
+      if (event_kind[p*8+:8] == 30 || event_kind[p*8+:8] == 31)
+        ec_cache_event(LEVEL, instance_id, int'(event_kind[p*8+:8]), event_flags[p*32+:32],
+          event_address[p*64+:64], event_tag[p*64+:64], event_value[p*64+:64],
+          event_set[p*32+:32], event_way[p*32+:32], event_occupancy[p*32+:32]);
+    ec_cache_finish(LEVEL, instance_id);
+  end
+`endif
+  // synthesis translate_on
+endmodule
