#!/bin/sh
export PATH=/bin:/sbin
mount -t devtmpfs devtmpfs /dev || { mknod /dev/console c 5 1; mknod /dev/null c 1 3; }
mount -t proc proc /proc
mount -t sysfs sysfs /sys
exec </dev/console >/dev/console 2>&1
echo "EC_DAC_B_ROI_CANDIDATE: source-event ROI hardware and B driver require manual validation"
echo "No benchmark runs automatically. Interactive shell is a prerequisite check only."
while true; do /bin/sh; sleep 1; done
