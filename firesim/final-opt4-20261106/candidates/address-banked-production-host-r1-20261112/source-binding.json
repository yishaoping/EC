      "new": "  // Each query result is reduced inside the shared bank. Carry is a\n  // separate channel from state-only retirement/query results.\n  def queryMatch(q: Int): Bool = bucketBanks.map(_.io.queryMatch(q)).reduce(_ || _)\n  val retiringValid = bucketBanks.map(_.io.retiringValid).reduce(_ || _)\n  val retiringCollision = bucketBanks.map(_.io.retiringCollision).reduce(_ || _)\n  val retiringWords = Wire(Vec(5, Vec(4, UInt(64.W))))\n  for (m <- 0 until 5; g <- 0 until 4) {\n    retiringWords(m)(g) := bucketBanks.map(_.io.retiringWords(m)(g)).reduce(_ | _)\n  }\n\n",
      "offset": 12062,
      "old": "  val bucketValid = Wire(Vec(packetWindow, Bool()))\n  val bucketSeq = Wire(Vec(packetWindow, UInt(GH_GlobalParams.GH_PACKET_SEQ_BITS.W)))\n  val bucketStore = Wire(Vec(packetWindow, Vec(4, UInt(64.W))))\n  val bucketLoadFirst = Wire(Vec(packetWindow, Vec(4, UInt(64.W))))\n  val bucketStoreFirst = Wire(Vec(packetWindow, Vec(4, UInt(64.W))))\n  val bucketStrictWriteRead = Wire(Vec(packetWindow, Vec(4, UInt(64.W))))\n  val bucketFirstStore = Wire(Vec(packetWindow, Vec(4, UInt(64.W))))\n  val bucketOverflows = Wire(Vec(packetWindow, Bool()))\n  for (b <- 0 until 16; i <- 0 until 16) {\n    val index = b * 16 + i\n    val state = bucketBanks(b).io.observe(i)\n    bucketOverflows(index) := state(1313)\n    bucketValid(index) := state(1312)\n    bucketSeq(index) := state(1311, 1280)\n    val metrics = Seq(bucketStore, bucketFirstStore, bucketLoadFirst,\n      bucketStoreFirst, bucketStrictWriteRead)\n    for (m <- 0 until 5; g <- 0 until 4) {\n      val lo = 64 * (4 * m + g)\n      metrics(m)(index)(g) := state(lo + 63, lo)\n    }\n  }\n\n  // A valid bucket's low sequence bits equal its fixed slot index. The high\n  // bits therefore distinguish the complete sequence without a low-bit mux.\n  private def bucketSequenceMatches(index: UInt, sequence: UInt): Bool =\n    bucketSeq(index)(GH_GlobalParams.GH_PACKET_SEQ_BITS - 1, packetIndexBits) ===\n      sequence(GH_GlobalParams.GH_PACKET_SEQ_BITS - 1, packetIndexBits)\n\n\n"
