diff --git a/chipyard/generators/rocket-chip/src/main/scala/diplomacy/DeviceTree.scala b/chipyard/generators/rocket-chip/src/main/scala/diplomacy/DeviceTree.scala
index 05ccdbb..453f5e7 100644
--- a/chipyard/generators/rocket-chip/src/main/scala/diplomacy/DeviceTree.scala
+++ b/chipyard/generators/rocket-chip/src/main/scala/diplomacy/DeviceTree.scala
@@ -4,7 +4,8 @@ package freechips.rocketchip.diplomacy
 
 import org.chipsalliance.cde.config.Field
 import sys.process._
-import java.io.{ByteArrayInputStream, ByteArrayOutputStream}
+import java.nio.ByteBuffer
+import java.nio.file.Files
 
 case object DTSModel    extends Field[String]
 case object DTSCompat   extends Field[Seq[String]] // -dev, -soc
@@ -130,12 +131,26 @@ case class DTB(contents: Seq[Byte])
 object DTB
 {
   def apply(dts: String): DTB = {
-    val instream = new ByteArrayInputStream(dts.getBytes("UTF-8"))
-    val outstream = new ByteArrayOutputStream
-    val proc = "dtc -O dtb" #< instream #> outstream
-    require (proc.! == 0, "Failed to run dtc; is it in your path?")
-    instream.close
-    outstream.close
-    DTB(outstream.toByteArray)
+    // Do not snapshot a process-pipe buffer: a successful dtc exit must not
+    // admit a partially drained DTB into the hardware ROM. File output is
+    // complete when dtc exits, and the header provides an independent check.
+    val directory = Files.createTempDirectory("ec-device-tree-")
+    val input = directory.resolve("input.dts")
+    val output = directory.resolve("output.dtb")
+    try {
+      Files.write(input, dts.getBytes("UTF-8"))
+      val proc = Process(Seq("dtc", "-I", "dts", "-O", "dtb", "-o", output.toString, input.toString))
+      require(proc.! == 0, "Failed to run dtc; is it in your path?")
+      val bytes = Files.readAllBytes(output)
+      require(bytes.length >= 40, "Truncated DTB header")
+      val header = ByteBuffer.wrap(bytes)
+      require(header.getInt(0) == 0xd00dfeed, "Invalid DTB magic")
+      require(header.getInt(4) == bytes.length, "Truncated or oversized DTB output")
+      DTB(bytes.toIndexedSeq)
+    } finally {
+      Files.deleteIfExists(output)
+      Files.deleteIfExists(input)
+      Files.deleteIfExists(directory)
+    }
   }
 }
