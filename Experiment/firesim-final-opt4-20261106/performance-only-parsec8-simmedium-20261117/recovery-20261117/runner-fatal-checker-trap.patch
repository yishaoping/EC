index 0000000..df98bc0
--- /dev/null
+++ b/fatal_traps.py
@@ -0,0 +1,48 @@
+"""Parse fresh UART evidence, never arbitrary mentions of trap-related words.
+
+The caller owns a new per-attempt log. This parser does not concatenate logs
+from earlier attempts. Register values are observations, not privilege proofs:
+the EC checker may expose shadow CSRs while privileged checking is active.
+"""
+import re
+
+_SBI = re.compile(r'^sbi_trap_error: hart(?P<hart>\d+): (?P<body>.+)$')
+_HEADER = re.compile(r'^[A-Za-z][A-Za-z -]* \(error -?\d+\)$')
+_REGS = re.compile(r'^(?:[a-z][a-z0-9]*=0x[0-9a-fA-F]+)(?: +[a-z][a-z0-9]*=0x[0-9a-fA-F]+)*$')
+_HANG = re.compile(r'^sbi_hart_hang(?:\(\))?: hart(?P<hart>\d+)(?:: (?:entering|halted|fatal))?$')
+_REGISTER = re.compile(r'\b([a-z][a-z0-9]*)=(0x[0-9a-fA-F]+)\b')
+
+
+def detect_fatal_traps(uart, checker_harts=(1, 2, 3, 4)):
+    """Return fatal hart records, including interleaved or partial dumps.
+
+    An OpenSBI error header or a correctly formatted register row is already
+    fatal: sbi_trap_error is noreturn in the bound firmware. No need to wait
+    for the complete GPR dump before stopping. Anchors reject echoed shell
+    commands, quoted fixtures, historical prefixes and informational prose.
+    """
+    text = uart.decode('utf-8', errors='replace') if isinstance(uart, bytes) else uart
+    harts = {}
+    for lineno, line in enumerate(text.replace('\r', '').split('\n'), 1):
+        match = _SBI.fullmatch(line)
+        source = 'sbi_trap_error'
+        body = match['body'] if match else ''
+        if match and not (_HEADER.fullmatch(body) or _REGS.fullmatch(body)):
+            match = None
+        if match is None:
+            match = _HANG.fullmatch(line)
+            source = 'sbi_hart_hang'
+        if match is None:
+            continue
+        hart = int(match['hart'])
+        record = harts.setdefault(hart, dict(hartid=hart,
+            role='checker' if hart in checker_harts else 'firmware',
+            registers={}, evidence=[]))
+        record['evidence'].append(dict(line=lineno, text=line, source=source))
+        record['registers'].update({k: v.lower() for k, v in _REGISTER.findall(body)})
+    if not harts:
+        return None
+    records = [harts[h] for h in sorted(harts)]
+    return dict(status='FAILED_CHECKER_TRAP' if any(h in checker_harts for h in harts)
+                else 'FAILED_FIRMWARE_TRAP',
+                harts=records, valid=False, roi_cycles=None, slowdown=None)
