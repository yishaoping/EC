+  if(!heap) exit(125);
+  for(size_t i=0;i<128*1024*1024;i+=4096) heap[i]=0;
+  free((void*)heap);
+}
+static void ec_finish_output(void) {
+  int fd=ec_staged_fd; ec_staged_fd=-1;
+  if(xwrite(fd,ec_staged_data,ec_staged_size)!=(int)ec_staged_size || close(fd)) exit(125);
+  free(ec_staged_data);
+}
