+#!/usr/bin/env python3
+"""Prepare an isolated constraint replay fix; mock-check the exact eight sets.
+
+Never sources the result into any Vivado process/checkpoint. No clock rates,
+exceptions, object memberships or setup/hold numbers are invented here.
+"""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+C=Path(__file__).resolve().parent
+O=Path(sys.argv[1]).resolve()
+P=Path('/var/tmp/guozh-ec-rtl-structure-r1-20261114/cad-r1/followthrough-r2')
+
+original='''    set result {set_clock_groups -asynchronous}
+    foreach names $groups {
+        set queries {}
+        foreach name $names {
+            # Clock names may contain literal [3]; pattern queries interpret
+            # those brackets. Equality filters preserve the exact clock name.
+            set filter [format {NAME == "%s"} $name]
+            lappend queries "\\[get_clocks -quiet -filter [list $filter]\\]"
+        }
+        append result " -group \\[concat [join $queries { }]\\]"
+    }
+    return $result'''
+
+def main():
+    source=P/'host-clock.tcl'
+    text=source.read_text()
+    assert text.count(original)==1, 'upstream recipe changed; refuse to guess'
+    helper=(C/'clock-group-replay-no-concat.tcl').read_text()
+    patched=helper+'\n'+text.replace(original,'    return [ec_exact_clock_groups $groups]')
+    assert '[concat ' not in patched
+    output=C/'host-clock-no-concat.tcl'
+    output.write_text(patched)
+    groups=P/'physical/candidates/structure-10mhz-ssi_spreadslls-r2/normalized-clock-groups.txt'
+    fixture='''source {%s}
+set f [open {%s} r]; set groups [read $f]; close $f
+set observed {}
+proc get_clocks {args} {
+    if {[lrange $args 0 1] ne {-quiet -filter}} {error "unknown query"}
+    set filter [lindex $args 2]
+    set names {}
+    foreach {unused name} [regexp -all -inline {NAME == "([^"]+)"} $filter] {lappend names $name}
+    if {![llength $names]} {error "empty mocked lookup"}
+    return $names
+}
+proc set_clock_groups {args} {
+    global observed
+    if {[lindex $args 0] ne "-asynchronous"} {error "changed group kind"}
+    set sets {}
+    for {set i 1} {$i < [llength $args]} {incr i 2} {
+        if {[lindex $args $i] ne "-group"} {error "unexpected group syntax"}
+        lappend sets [lsort [lindex $args [expr {$i+1}]]]
+    }
+    lappend observed $sets
+}
+if {[llength $groups] != 8} {error "expected eight original group pairs"}
+foreach pair $groups {
+    set command [ec_exact_clock_groups $pair]
+    if {[string first concat $command] >= 0} {error "unsupported command remains"}
+    eval $command
+}
+set expected {}
+foreach pair $groups {
+    set sets {}; foreach names $pair {lappend sets [lsort $names]};lappend expected $sets
+}
+if {$observed ne $expected} {error "clock-set membership changed"}
+set command [ec_exact_clock_groups {{{literal[3]} clkB} {clkC}}]
+eval $command
+if {[lindex $observed end] ne {{clkB {literal[3]}} clkC}} {error "literal bracket/union check failed"}
+if {[string index [ec_exact_clock_groups {{} {clkB}}] 0] ne "#"} {error "empty group changed"}
+puts CLOCK_GROUP_REPLAY_OFFLINE_PASS_original_pairs_8_literal_brackets_union_and_empty
+'''%(C/'clock-group-replay-no-concat.tcl',groups)
+    test=O/'clock-group-replay-test.tcl';test.write_text(fixture)
+    r=subprocess.run(['/usr/bin/tclsh',str(test)],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)
+    (O/'clock-group-replay-test.log').write_text(r.stdout)
+    assert r.returncode==0,r.stdout
+    (O/'constraint-candidate.json').write_text(json.dumps(dict(
+        status='PASS_OFFLINE_EXACT_CLOCK_SET_TEST_NOT_VIVADO_REPLAYED',
+        upstream=str(source),upstream_sha256=hashlib.sha256(source.read_bytes()).hexdigest(),
+        candidate=str(output),candidate_sha256=hashlib.sha256(output.read_bytes()).hexdigest(),
+        existing_resolved_groups=str(groups),actual_checkpoint_test_pending=True,
+        active_CAD_modified=False,new_false_paths_added=False),indent=2)+'\n')
+
+if __name__=='__main__':main()
