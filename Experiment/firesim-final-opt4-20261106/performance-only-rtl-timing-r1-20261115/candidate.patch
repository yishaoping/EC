+#!/usr/bin/env python3
+"""Two sequential one-CPU Yosys module screens, never full-shell CAD.
+
+These are Xilinx UltraScale+ mapped estimates, NOT Vivado routed timing/area.
+"""
+import collections
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+O = Path(sys.argv[1]).resolve()
+def main():
+    os.sched_setaffinity(0, {249})
+    os.nice(10)
+    result = dict(tool='Yosys synth_xilinx -family xcu',
+                  vivado=False, physical_timing_measured=False, full_shell=False,
+                  width=82, depth=256, rtl_sha256=hashlib.sha256((O/'target/QueuePair.v').read_bytes()).hexdigest(), modules={})
+    for top in ['GH_FIFO_SC_Reference', 'GH_FIFO_SC']:
+        d = O/('synth-'+top)
+        d.mkdir(exist_ok=False)
+        script = '''read_verilog -sv ../target/QueuePair.v
+synth_xilinx -family xcu -top %s -noiopad -noclkbuf
+tee -o stat.json stat -json
+write_json mapped.json
+'''%top
+        (d/'synth.ys').write_text(script)
+        with (d/'service.log').open('wb') as f:
+            p = subprocess.run(['/usr/local/bin/yosys','-Q','-T','-l','synth.log','-s','synth.ys'],
+                cwd=d, stdout=f, stderr=subprocess.STDOUT, timeout=1800)
+        assert p.returncode == 0, (top, p.returncode)
+        mapped = json.loads((d/'mapped.json').read_text())['modules'][top]
+        counts = collections.Counter(c['type'] for c in mapped['cells'].values())
+        loads = collections.defaultdict(list)
+        for cn,c in mapped['cells'].items():
+            for pin,bits in c['connections'].items():
+                if c['port_directions'][pin] == 'input' and pin not in ['C','CLK','WCLK']:
+                    for b in bits:
+                        if isinstance(b,int): loads[b].append(cn+'/'+pin)
+        fanout={n:max([len(loads[b]) for b in p['bits']],default=0)
+                for n,p in mapped['ports'].items() if p['direction']=='input'}
+        ram_luts = 0
+        for k,v in counts.items():
+            # Physical LUT equivalents of distributed RAM primitives in this
+            # family. Preserve raw primitive counts for independent auditing.
+            if k in ['RAM64X1S','RAM32X1S','RAM32X1D','RAM64X1D']: ram_luts += v*(2 if k.endswith('D') else 1)
+            elif k == 'RAM256X1S': ram_luts += 4*v
+            elif k == 'RAM128X1S': ram_luts += 2*v
+            elif k == 'RAM32M': ram_luts += 4*v
+            elif k == 'RAM64M': ram_luts += 4*v
+            elif k.startswith('RAM') and not k.startswith('RAMB'):
+                raise AssertionError(('unaccounted distributed RAM',k))
+        result['modules'][top]=dict(cells=dict(counts),
+            ff=sum(v for k,v in counts.items() if k.startswith('FD')),
+            logic_lut=sum(v for k,v in counts.items() if k.startswith('LUT')),
+            distributed_ram_lut=ram_luts,
+            input_max_data_pin_fanout=fanout,
+            max_nonclock_net_fanout=max(map(len,loads.values())),
+            mapped_json_sha256=hashlib.sha256((d/'mapped.json').read_bytes()).hexdigest())
+        (O/'synth-results.json').write_text(json.dumps(result,indent=2)+'\n')
+    result['status']='PASS_PAIRED_MODULE_MAPPING'
+    (O/'synth-results.json').write_text(json.dumps(result,indent=2)+'\n')
+
+if __name__=='__main__':main()
