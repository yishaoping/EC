+++ b/candidates/rtl-timing-r1/Emit.scala
@@ -0,0 +1,36 @@
+package ectiming
+import chisel3._
+import freechips.rocketchip.guardiancouncil._
+
+class QueuePair extends Module {
+  val io = IO(new Bundle {
+    val enq_valid = Input(Bool())
+    val enq_bits = Input(UInt(82.W))
+    val reserve = Input(Bool())
+    val commit = Input(Bool())
+    val rollback = Input(Bool())
+    val replay = Input(Bool())
+    val equivalent = Output(Bool())
+    val full = Output(Bool())
+    val valid = Output(Bool())
+    val can_commit = Output(Bool())
+    val occupancy = Output(UInt(8.W))
+  })
+  val reference = Module(new GH_FIFO_SC_Reference(FIFOParams(82,256)))
+  val candidate = Module(new GH_FIFO_SC(FIFOParams(82,256)))
+  for (q <- Seq(reference.io,candidate.io)) {
+    q.enq_valid := io.enq_valid; q.enq_bits := io.enq_bits
+    q.reserve := io.reserve; q.commit := io.commit
+    q.rollback := io.rollback; q.need_replay_1 := io.replay
+  }
+  def outputs(q: FIFO_SC_IO): UInt =
+    chisel3.util.Cat(q.full,q.peek_valid,q.peek_bits,q.can_commit,
+      q.num_content,q.status_twoslots,q.status_threeslots,q.high_watermark)
+  io.equivalent := outputs(reference.io) === outputs(candidate.io)
+  io.full := reference.io.full; io.valid := reference.io.peek_valid
+  io.can_commit := reference.io.can_commit; io.occupancy := reference.io.num_content
+}
+
+object Emit extends App {
+  (new chisel3.stage.ChiselStage).emitVerilog(new QueuePair,Array("--target-dir",args(0)))
+}
diff --git a/candidates/rtl-timing-r1/Host.scala b/candidates/rtl-timing-r1/Host.scala
new file mode 100644
index 0000000..4adcda0
--- /dev/null
+++ b/candidates/rtl-timing-r1/Host.scala
@@ -0,0 +1,59 @@
+package ectiming
+import chisel3._
+import midas.widgets.{PeekPokeBridge, RationalClock, RationalClockBridge}
+import org.chipsalliance.cde.config.{Config, Parameters}
+
+class HostIO extends Bundle {
+  val clear = Input(Bool())
+  val enqValid = Input(Bool())
+  val enqBits = Input(UInt(82.W))
+  val reserve = Input(Bool())
+  val commit = Input(Bool())
+  val rollback = Input(Bool())
+  val replay = Input(Bool())
+  // One comparison token covers every output, including invalid peek_bits.
+  val equivalent = Output(Bool())
+  val full = Output(Bool())
+  val valid = Output(Bool())
+  val canCommit = Output(Bool())
+}
+
+class QueuePairHost(implicit p: Parameters) extends RawModule {
+  val clock = RationalClockBridge().io.clocks.head
+  val reset = WireInit(false.B)
+  val io = Wire(new HostIO)
+  val pair = withClockAndReset(clock, reset || io.clear) { Module(new QueuePair) }
+  pair.io.enq_valid := io.enqValid
+  pair.io.enq_bits := io.enqBits
+  pair.io.reserve := io.reserve
+  pair.io.commit := io.commit
+  pair.io.rollback := io.rollback
+  pair.io.replay := io.replay
+  io.equivalent := pair.io.equivalent
+  io.full := pair.io.full
+  io.valid := pair.io.valid
+  io.canCommit := pair.io.can_commit
+  // Verification-only edge snapshot and one atomic input token: independently
+  // poked fields must not become different target input cycles. No extra
+  // register is inserted into either DUT or into its real interface.
+  val inputs = Wire(Input(UInt(88.W)))
+  io.clear := inputs(0); io.enqValid := inputs(1)
+  io.reserve := inputs(2); io.commit := inputs(3)
+  io.rollback := inputs(4); io.replay := inputs(5)
+  io.enqBits := inputs(87,6)
+  val outputs = Wire(Output(UInt(4.W)))
+  outputs := withClockAndReset(clock,reset) {
+    RegNext(chisel3.util.Cat(io.equivalent,io.full,io.valid,io.canCommit),0.U)
+  }
+  PeekPokeBridge(clock,reset,"inputs" -> inputs,"outputs" -> outputs)
+}
+
+class PlainConfig extends Config(new Config((site,here,up) => {
+  case midas.GenerateMultiCycleRamModels => true
+  case midas.EnableModelMultiThreading => false
+}) ++ new firesim.configs.DacXilinxAlveoConfig)
+
+object EmitHost extends App {
+  implicit val p: Parameters = new PlainConfig
+  (new chisel3.stage.ChiselStage).emitVerilog(new QueuePairHost,Array("--target-dir",args(0)))
+}
