+        timing={
+            'Old15FailedRoute':timing(R/'performance-only-cdc-lowfreq-r1-20261114/physical/candidates/mem-15mhz-altspreadlogic_high/timing.rpt','failed/illegal routing; not a usable bitstream'),
+            'Current10PostPlace':timing(P/'timing-after-physopt.rpt','postPlace phys_opt estimates; not postRoute'),
+            'NativeRouted':timing(R/'paper-area-power/raw/native-B/impl_1/design_1_wrapper_timing_summary_routed.rpt','Native routed report; source bound by context_manifest.json'),
+            'SVBRouted':timing(R/'cycleprecise-svb-host40-shell-recovery-r7-20261112/K-postroute-aggressive-explore/final-timing.rpt','SVB component routed; full EC absent')})
+    fan=(P/'fanout-placed.rpt').read_text()
+    result['BJL_physical_fanout_rows']=[l.strip() for l in fan.splitlines() if 'BJL/u_channel_bj' in l]
+    result['per_slr']=dict(file=str(P/'per-slr-after-physopt.rpt'),sha256=sha(P/'per-slr-after-physopt.rpt'),
+        clb_occupancy_percent=[97.78,94.93,99.13],sll_usage_percent=[10.26,12.36],
+        conclusion='CLB occupancy/local routing pressure is severe; SLL aggregate capacity is not saturated.')
+    result['source_lineage']={}
+    for rel in ['chipyard/generators/rocket-chip/src/main/scala/guardiancouncil/GH_FIFO.scala',
