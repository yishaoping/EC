+}
+close $f
+report_clocks -file "$ec_probe_out/clocks.rpt"
+check_timing -verbose -file "$ec_probe_out/check-timing.rpt"
+# No create_clock, false_path, placement, routing, register or IP edits.
diff --git a/candidates/rtl-timing-r1/formal.py b/candidates/rtl-timing-r1/formal.py
new file mode 100644
index 0000000..2140768
--- /dev/null
+++ b/candidates/rtl-timing-r1/formal.py
@@ -0,0 +1,258 @@
+#!/usr/bin/env python3
+"""Inductive reset-mask refinement of the actual 82x256 emitted queues.
+
+No bounded-reachability assumptions: all pointer/mask/data states are arbitrary.
+The relation is reference[i] == (written[i] ? memory[i] : 0).
+Payload projection is permitted only after checking every full-width output
+and next-state cone for lane independence and identical lane functions.
+"""
+import copy
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+O = Path(sys.argv[1]).resolve()
+WIDTH, DEPTH = 82, 256
+
+def sha(p):
+    return hashlib.sha256(p.read_bytes()).hexdigest()
+
+def cut(m):
+    m = copy.deepcopy(m)
+    states = {}
+    for cn, c in list(m['cells'].items()):
+        if c['type'] != '$dff':
+            assert not any(x in c['type'] for x in ['dff', 'latch']), c['type']
+            continue
+        aliases = [(n, v) for n, v in m['netnames'].items()
+                   if v['bits'] == c['connections']['Q'] and not n.startswith('$')]
+        canonical = [(n,v) for n,v in aliases if n in ['wptr','sptr','cptr']
+                     or re.fullmatch(r'(mem_\d+|mem\[\d+\]|written_\d+)', n)]
+        assert len(canonical) == 1, aliases
+        n, v = canonical[0]
+        n = re.sub(r'^mem\[(\d+)\]$', r'mem_\1', n)
+        states[n] = dict(width=len(c['connections']['Q']),
+                         init=v.get('attributes', {}).get('init'),
+                         parameters=c['parameters'])
+        assert int(c['parameters']['CLK_POLARITY'], 2) == 1
+        assert set(c['connections']) == {'CLK', 'Q', 'D'}
+        del m['cells'][cn]
+        for pin, bits in c['connections'].items():
+            port = pin + '__' + n
+            m['ports'][port] = dict(direction='input' if pin == 'Q' else 'output', bits=bits)
+            m['netnames'][port] = dict(hide_name=0, bits=bits, attributes={})
+    return m, states
+
+def lane_check(m):
+    leaves = {}
+    for n, p in m['ports'].items():
+        if p['direction'] == 'input' and len(p['bits']) == WIDTH:
+            assert n == 'io_enq_bits' or n.startswith('Q__mem_'), n
+            for lane, bit in enumerate(p['bits']):
+                leaves[bit] = n, lane
+    drivers = {}
+    for c in m['cells'].values():
+        for p, bits in c['connections'].items():
+            if c['port_directions'][p] == 'output':
+                for i, b in enumerate(bits):
+                    assert b not in drivers
+                    drivers[b] = c, p, i
+    dep, busy, signatures, controls = {}, set(), {}, {}
+    def dependent(b):
+        if b in leaves:
+            return True
+        if b in dep:
+            return dep[b]
+        assert b not in busy, 'combinational loop'
+        busy.add(b)
+        val = b in drivers and any(dependent(x)
+            for p, xs in drivers[b][0]['connections'].items()
+            if drivers[b][0]['port_directions'][p] == 'input' for x in xs)
+        busy.remove(b)
+        dep[b] = val
+        return val
+    def control(b):
+        if b in controls:
+            return controls[b]
+        assert not dependent(b)
+        if b not in drivers:
+            val = ('control_input', b)
+        else:
+            c, pin, i = drivers[b]
+            kind = c['type']
+            def component(p):
+                assert i < len(c['connections'][p])
+                return control(c['connections'][p][i])
+            if kind in ['$and','$or','$xor']:
+                expr = kind, sorted([repr(component('A')),repr(component('B'))])
+            elif kind == '$not':
+                expr = kind, component('A')
+            elif kind == '$mux':
+                expr = kind, component('A'), component('B'), control(c['connections']['S'][0])
+            else:
+                expr = (kind,pin,i,sorted(c['parameters'].items()),
+                    [(p,[control(x) for x in xs]) for p,xs in sorted(c['connections'].items())
+                     if c['port_directions'][p] == 'input'])
+            val = hashlib.sha256(repr(expr).encode()).hexdigest()
+        controls[b] = val
+        return val
+    def signature(b):
+        if b in signatures:
+            return signatures[b]
+        if b in leaves:
+            n, lane = leaves[b]
+            val = lane, ('input', n)
+        elif not dependent(b):
+            val = None, control(b)
+        else:
+            c, pin, i = drivers[b]
+            assert pin == 'Y'
+            kind = c['type']
+            def component(p):
+                assert i < len(c['connections'][p]), (kind, p, i)
+                return signature(c['connections'][p][i])
+            if kind == '$mux':
+                sel = c['connections']['S']
+                assert len(sel) == 1 and not dependent(sel[0])
+                children = [component('A'), component('B')]
+                op = kind, control(sel[0])
+            elif kind in ['$and', '$or', '$xor']:
+                children = [component('A'), component('B')]
+                op = (kind,)
+            elif kind == '$not':
+                children = [component('A')]
+                op = (kind,)
+            else:
+                raise AssertionError(('unsupported payload operation', kind))
+            lanes = {i for i, _ in children if i is not None}
+            assert len(lanes) <= 1, ('cross-lane mixing', c)
+            hs = [repr(x) for _, x in children]
+            if kind in ['$and', '$or', '$xor']:
+                hs.sort()
+            val = next(iter(lanes), None), hashlib.sha256(repr((op, hs)).encode()).hexdigest()
+        signatures[b] = val
+        return val
+    checked = []
+    for n, p in m['ports'].items():
+        if p['direction'] != 'output':
+            continue
+        if len(p['bits']) == WIDTH:
+            s = [signature(b) for b in p['bits']]
+            assert all(lane == i for i, (lane, _) in enumerate(s)), n
+            assert all(h == s[0][1] for _, h in s), n
+            checked.append(n)
+        else:
+            assert not any(dependent(b) for b in p['bits']), ('payload-dependent control', n)
+    assert len(checked) == DEPTH + 1
+    return dict(width=WIDTH, depth=DEPTH, checked_outputs=checked,
+                independent_identical_payload_lanes=True, controls_payload_independent=True)
+
+def main():
+    os.sched_setaffinity(0, {248})
+    os.nice(10)
+    raw = json.loads((O/'flattened.json').read_text())
+    modules, states, symmetry = {}, {}, {}
+    for orig, name in [('GH_FIFO_SC_Reference', 'RefCut'), ('GH_FIFO_SC', 'MemCut')]:
+        m, s = cut(raw['modules'][orig])
+        assert set(s) == ({'wptr', 'sptr', 'cptr'} |
+            {'mem_%d'%i for i in range(DEPTH)} |
+            ({'written_%d'%i for i in range(DEPTH)} if name == 'MemCut' else set()))
+        for n, st in s.items():
+            assert st['width'] == (WIDTH if n.startswith('mem_') else 1 if n.startswith('written_') else 8)
+            # RegInit is a synchronous reset equation, not necessarily an FPGA
+            # power-up initializer. The separate reset-base SAT proves entry.
+            if st['init'] is not None:
+                assert int(st['init'], 2) == 0, (n, st)
+        symmetry[name] = lane_check(m)
+        for n, p in m['ports'].items():
+            if len(p['bits']) == WIDTH:
+                p['bits'] = p['bits'][:1]
+                m['netnames'][n]['bits'] = p['bits']
+        modules[name], states[name] = m, s
+    (O/'lane-symmetry.json').write_text(json.dumps(symmetry, indent=2)+'\n')
+    (O/'state-mapping.json').write_text(json.dumps(states, indent=2)+'\n')
+    (O/'projected-cut.json').write_text(json.dumps(dict(modules=modules))+'\n')
+    lines = ['module Relation(', 'input clock, reset, io_enq_valid, io_reserve, io_commit, io_rollback, io_need_replay_1,',
+             'input io_enq_bits, input [7:0] wptr, sptr, cptr,',
+             'input [255:0] payload, written, output ok);']
+    checks = []
+    for name, m in modules.items():
+        prefix = 'r' if name == 'RefCut' else 't'
+        args = []
+        for n, p in m['ports'].items():
+            width = len(p['bits'])
+            if p['direction'] == 'output':
+                wire = prefix+'_'+n
+                lines.append('wire [%d:0] %s;'%(width-1, wire))
+                val = wire
+                if name == 'RefCut':
+                    if n.startswith('D__mem_'):
+                        i = n[len('D__mem_'):]
+                        checks.append('(%s == (t_D__written_%s & t_%s))'%(wire, i, n))
+                    else:
+                        checks.append('(%s == t_%s)'%(wire, n))
+            elif n.startswith('Q__mem_'):
+                i = n[len('Q__mem_'):]
+                val = 'payload[%s]'%i
+                if name == 'RefCut':
+                    val = '('+val+' & written[%s])'%i
+            elif n.startswith('Q__written_'):
+                val = 'written[%s]'%n[len('Q__written_'):]
+            else:
+                val = n.removeprefix('Q__')
+            args.append('.%s(%s)'%(n, val))
+        lines.append('%s %s(%s);'%(name, prefix, ','.join(args)))
+    lines.extend(['assign ok = '+' & '.join(checks)+';', 'endmodule'])
+    text = '\n'.join(lines)+'\n'
+    (O/'relation.v').write_text(text)
+    script = '''read_json projected-cut.json
+read_verilog relation.v
+hierarchy -top Relation
+flatten
+techmap
+opt -full
+check -assert
+sat -verify -prove ok 1 -set-def-inputs -show-inputs -show ok
+'''
+    base = text.replace('input [255:0] payload, written, output ok);',
+        'input [255:0] payload, written, ref_payload, input [7:0] ref_wptr, ref_sptr, ref_cptr, output ok);')
+    old_inst = next(l for l in base.splitlines() if l.startswith('RefCut r('))
+    new_inst = old_inst
+    for i in range(DEPTH):
+        new_inst = new_inst.replace('(payload[%d] & written[%d])'%(i,i), 'ref_payload[%d]'%i)
+    for p in ['wptr','sptr','cptr']:
+        new_inst = new_inst.replace('.Q__%s(%s)'%(p,p), '.Q__%s(ref_%s)'%(p,p))
+    base = base.replace(old_inst, new_inst)
+    base_checks = ['(r_D__mem_%d == 0)'%i for i in range(DEPTH)]
+    base_checks += ['(t_D__written_%d == 0)'%i for i in range(DEPTH)]
+    base_checks += ['(%s_D__%s == 0)'%(side,p) for side in ['r','t'] for p in ['wptr','sptr','cptr']]
+    base = re.sub(r'assign ok = .*;', 'assign ok = !reset | ('+' & '.join(base_checks)+');', base)
+    for label, v in [('proof', text), ('reset-base', base), ('negative', text.replace('(t_D__written_0 & t_D__mem_0)', 't_D__mem_0'))]:
+        assert label != 'negative' or v != text
+        (O/'relation.v').write_text(v)
+        (O/(label+'.ys')).write_text(script)
+        with (O/(label+'-service.log')).open('wb') as f:
+            p = subprocess.run(['/usr/local/bin/yosys','-Q','-T','-l',label+'.log','-s',label+'.ys'],
+                cwd=O, stdout=f, stderr=subprocess.STDOUT, timeout=900)
+        log = (O/(label+'.log')).read_text()
+        if label != 'negative':
+            assert p.returncode == 0 and 'no model found: SUCCESS!' in log
+        else:
+            assert p.returncode != 0 and 'proof did fail' in log
+    (O/'relation.v').write_text(text)
+    (O/'result.json').write_text(json.dumps(dict(
+        status='PASS_INDUCTIVE_RESET_MASK_REFINEMENT', width=WIDTH, depth=DEPTH,
+        rtl_sha256=sha(O.parent/'target/QueuePair.v'),
+        flattened_sha256=sha(O/'flattened.json'),
+        relation='reference[i] == (written[i] ? memory[i] : 0), identical pointers',
+        initialization='Separate SAT with unrelated reference/candidate current states proves reset sets reference payload, written bits and both sets of pointers to zero; candidate payload arbitrary.',
+        method='All full-width payload next-state/public-output cones checked for lane independence/symmetry. SAT proves every control/output/clock and projected data next-state relation for arbitrary state and inputs; induction extends to all cycles/all 82 lanes.',
+        negative_control='Removing word-zero next-state masking produces a counterexample.',
+        full_system_equivalence=False), indent=2)+'\n')
+
+if __name__ == '__main__':
+    main()
