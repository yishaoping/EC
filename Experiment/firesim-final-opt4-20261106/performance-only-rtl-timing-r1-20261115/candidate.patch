+#!/usr/bin/env python3
+"""Bounded paired *module* Vivado measurements, two CPUs, nice 19.
+
+Does not read/write/implement any full-shell project or touch FPGA devices.
+Both actual 82x256 queues use identical part, constraints and commands.
+"""
+import datetime as dt
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+O = Path(sys.argv[1]).resolve()
+A = O/'module-vivado'
+
+def resources(p):
+    result = {}
+    for line in p.read_text().splitlines():
+        c = [x.strip().rstrip('*') for x in line.split('|')]
+        if len(c)>6 and c[1] in ['CLB LUTs','CLB Registers','LUT as Logic','LUT as Memory',
+                'F7 Muxes','F8 Muxes','F9 Muxes','CARRY8','Block RAM Tile','DSPs','URAM']:
+            result.setdefault(c[1],float(c[2].replace(',','')))
+    return result
+
+def main():
+    os.sched_setaffinity(0,{248,249})
+    os.nice(19)
+    assert json.loads((O/'formal/result.json').read_text())['status']=='PASS_INDUCTIVE_RESET_MASK_REFINEMENT'
+    assert 'PASS' in json.loads((O/'state.json').read_text())['status']
+    A.mkdir(exist_ok=False)
+    rtl=O/'target/QueuePair.v'
+    digest=hashlib.sha256(rtl.read_bytes()).hexdigest()
+    result=dict(profile='EC Performance-Only BJL storage candidate', full_shell=False,
+        host_transform_included=False, fpga_access=False, max_threads=2, nice=19,
+        cpus=[248,249],part='xcu280-fsvh2892-2L-e',period_ns=100,
+        rtl_sha256=digest,modules={})
+    for top in ['GH_FIFO_SC_Reference','GH_FIFO_SC']:
+        d=A/top; d.mkdir()
+        (d/'run.tcl').write_text('''set_param general.maxThreads 2
+read_verilog {%s}
+synth_design -top %s -part xcu280-fsvh2892-2L-e -mode out_of_context -flatten_hierarchy rebuilt
+create_clock -name queue -period 100.0 [get_ports clock]
+set_input_delay -clock queue 0 [get_ports -filter {DIRECTION == IN && NAME != clock}]
+set_output_delay -clock queue 0 [all_outputs]
+opt_design
+write_checkpoint -force postopt.dcp
+report_utilization -file postopt-utilization.rpt
+place_design
+phys_opt_design -fanout_opt
+route_design
+write_checkpoint -force routed.dcp
+report_utilization -file utilization.rpt
+report_timing_summary -report_unconstrained -file timing.rpt
+report_timing -delay_type max -max_paths 20 -input_pins -nets -file setup.rpt
+report_timing -delay_type min -max_paths 20 -input_pins -nets -file hold.rpt
+report_high_fanout_nets -max_nets 20 -file fanout.rpt
+report_route_status -file route-status.rpt
+report_drc -file drc.rpt
+puts EC_BJL_PAIRED_MODULE_MEASUREMENT_COMPLETE
+exit 0
+'''%(rtl,top))
+        result.update(status='RUNNING_MODULE_ONLY_'+top,utc=dt.datetime.now(dt.timezone.utc).isoformat())
+        (A/'result.json').write_text(json.dumps(result,indent=2)+'\n')
+        env={k:v for k,v in os.environ.items() if k not in ['PYTHONHOME','PYTHONPATH',
+            'LD_LIBRARY_PATH','LD_PRELOAD','JAVA_TOOL_OPTIONS']}
+        env['OMP_NUM_THREADS']='2'
+        with (d/'stdout.log').open('wb') as f:
