@@ -0,0 +1,38 @@
+#include "TestHarness.h"
+#include <iostream>
+class TestQueue final : public TestHarness {
+  bool negative=false;
+public:
+  TestQueue(widget_registry_t &r,const std::vector<std::string>&a,std::string_view n)
+    :TestHarness(r,a,n){for(auto &x:a)if(x=="+negative")negative=true;}
+  void run_test() override {
+    log=false;
+    mpz_t payload;mpz_init(payload);
+    poke("inputs",payload);target_reset(16);
+    unsigned full=0,empty=0,commits=0,rollback=0,replay=0;
+    for(unsigned t=0;t<4096;++t){
+      unsigned r=random(),phase=t%1024;
+      bool ev=phase<800 || (r&1), reserve=phase>=300&&(phase<800||((r>>1)&1));
+      bool commit=phase>=600&&(phase<800||((r>>2)&1));
+      bool rb=phase>=800&&r%31==0,rp=phase>=800&&r%17==0;
+      mpz_set_ui(payload,random());mpz_mul_2exp(payload,payload,64);
+      mpz_add_ui(payload,payload,random());mpz_fdiv_r_2exp(payload,payload,82);
+      mpz_mul_2exp(payload,payload,6);
+      mpz_add_ui(payload,payload,(t==2048)|(ev<<1)|(reserve<<2)|(commit<<3)|(rb<<4)|(rp<<5));
+      poke("inputs",payload);step(1);
+      unsigned snapshot=peek("outputs");
+      bool eq=(snapshot>>3)&1;
+      if(negative&&t==100)eq=!eq;
+      if(!expect(eq&&!peek_poke.timeout()&&!peek_poke.unstable(),"BJL exact token outputs")){
+        std::cerr<<"BJL_HOST_TOKEN_MISMATCH token="<<t<<"\n";return;
+      }
+      full+=(snapshot>>2)&1;empty+=!((snapshot>>1)&1);
+      commits+=commit&&(snapshot&1);rollback+=rb;replay+=rp;
+    }
+    if(!expect(full>100&&empty>0&&commits>0&&rollback>0&&replay>0,"BJL boundary coverage"))return;
+    std::cout<<"BJL_HOST_TOKEN_PASS tokens=4096 full="<<full<<" empty="<<empty
+      <<" commits="<<commits<<" rollback="<<rollback<<" replay="<<replay<<"\n";
+    mpz_clear(payload);
+  }
+};
+TEST_MAIN(TestQueue)
