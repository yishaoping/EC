diff --git a/candidates/rtl-timing-r1/clock-group-replay-no-concat.tcl b/candidates/rtl-timing-r1/clock-group-replay-no-concat.tcl
new file mode 100644
index 0000000..ae04b7c
--- /dev/null
+++ b/candidates/rtl-timing-r1/clock-group-replay-no-concat.tcl
@@ -0,0 +1,22 @@
+# Candidate helper for the existing host-clock.tcl normalizer. Not sourced into
+# active CAD. Replays precisely the previously resolved clock sets; no new
+# exceptions, no relaxation of DDR/PCIe/target periods or setup/hold requirements.
+# Replace only ec_record_groups's "queries/concat" emission with this function.
+proc ec_exact_clock_query {names} {
+    if {![llength $names]} {error "empty clock set must not produce a new exception"}
+    set clauses {}
+    foreach name $names {
+        if {[regexp {["\\\n\r]} $name]} {error "unsupported clock name quoting"}
+        lappend clauses [format {NAME == "%s"} $name]
+    }
+    return "\[get_clocks -quiet -filter [list [join $clauses { || }]]\]"
+}
+proc ec_exact_clock_groups {groups} {
+    if {[llength $groups] != 2} {error "expected the two original resolved clock sets"}
+    foreach names $groups {
+        if {![llength $names]} {return "# Original empty scoped group; preserve no exception."}
+    }
+    set command {set_clock_groups -asynchronous}
+    foreach names $groups {append command " -group [ec_exact_clock_query $names]"}
+    return $command
+}
diff --git a/candidates/rtl-timing-r1/compare.cpp b/candidates/rtl-timing-r1/compare.cpp
new file mode 100644
index 0000000..94dd773
--- /dev/null
+++ b/candidates/rtl-timing-r1/compare.cpp
@@ -0,0 +1,38 @@
+#include "VQueuePair.h"
+#include "verilated.h"
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+static uint64_t rng=0x8491167d6fada307ULL;
+static uint32_t next32(){rng^=rng<<13;rng^=rng>>7;rng^=rng<<17;return uint32_t(rng);}
+int main(int argc,char**argv){
+  Verilated::commandArgs(argc,argv); VQueuePair d;
+  unsigned full=0,empty=0,rb=0,replay=0,reset_write=0,commit_enq=0,cycles=0;
+  auto tick=[&](){
+    d.clock=0;d.eval();
+    if(cycles>0 && !d.io_equivalent){std::printf("MISMATCH before cycle=%u\n",cycles);std::exit(1);}
+    full+=d.io_full;empty+=!d.io_valid;rb+=d.io_rollback;
+    replay+=d.io_replay;reset_write+=d.reset&&d.io_enq_valid;
+    commit_enq+=d.io_commit&&d.io_can_commit&&d.io_enq_valid;
+    d.clock=1;d.eval();
+    if(!d.io_equivalent){std::printf("MISMATCH after cycle=%u\n",cycles);std::exit(1);}
+    ++cycles;
+  };
+  d.reset=1;d.io_enq_valid=0;d.io_reserve=0;d.io_commit=0;d.io_rollback=0;d.io_replay=0;tick();
+  for(unsigned episode=0;episode<16;++episode){
+    for(unsigned t=0;t<8192;++t){
+      d.reset=(t==0||t==4096);d.io_enq_valid=1;
+      for(unsigned i=0;i<3;++i)d.io_enq_bits[i]=next32(); d.io_enq_bits[2]&=0x3ffff;
+      d.io_rollback=0;d.io_replay=0;d.io_reserve=0;d.io_commit=0;
+      if(t>=300 && t<600)d.io_reserve=1;
+      if(t>=600 && t<1200){d.io_reserve=1;d.io_commit=1;}
+      if(t>=1200){
+        auto r=next32();d.io_enq_valid=r&1;d.io_reserve=(r>>1)&1;
+        d.io_commit=(r>>2)&1;d.io_rollback=(r%31)==0;d.io_replay=(r%17)==0;
+      }
+      tick();
+    }
+  }
+  if(!full||!empty||!rb||!replay||!reset_write||!commit_enq)return 2;
+  std::printf("BJL_FIFO_ALL_OUTPUTS_CYCLE_PASS cycles=%u full=%u empty=%u rollback=%u replay=%u reset_write=%u commit_enq=%u\n",cycles,full,empty,rb,replay,reset_write,commit_enq);
+}
