+            '-Xplugin:'+cfg['plugin'],'-d',classes,C/'Host.scala'],env)
+    cp=str(classes)+':'+cp
+    if not resume:
+        run('emit',java+['-cp',cp,'ectiming.EmitHost',target],env)
+    generated=H/'generated';generated.mkdir(exist_ok=resume)
+    if not resume:
+        run('goldengate',java+['-cp',cp,'midas.stage.GoldenGateMain','-i',target/'QueuePairHost.fir',
+            '-td',generated,'-faf',target/'QueuePairHost.anno.json','-ggcp','ectiming','-ggcs','PlainConfig',
+            '--output-filename-base','FireSim-generated'],env)
+    listing=generated/'firrtl_black_box_resource_files.f'
+    simulation=generated/'simulation.sv'
+    simulation.write_text((generated/'FireSim-generated.sv').read_text()+
+        ''.join(Path(p).read_text() for p in (listing.read_text().splitlines() if listing.exists() else []) if p.strip()))
+    clang='/nix/store/zxw41nfy4gjlzd31ly7q6mkv4vkybx15-clang-wrapper-16.0.6/bin/clang++'
+    verilator='/nix/store/bj3wbpawbk71c082cvrnqkfyix7ipx0g-verilator-5.048/bin/verilator'
+    fs=T.parent/'C4/chipyard/sims/firesim/sim'
+    deps=R/'build-logs/Opt4-mcrams-address-bucket-r2-20261112'
+    env.update(CCACHE_DISABLE='1',LD_LIBRARY_PATH='',OMP_NUM_THREADS='2',
