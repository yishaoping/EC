+    classes=H/'classes';classes.mkdir(exist_ok=resume);target=H/'target';target.mkdir(exist_ok=resume)
+    java=[cfg['java'],'-Xmx8G','-Xss16M','-XX:ActiveProcessorCount=2','-Dec.dac.firesim=true']
