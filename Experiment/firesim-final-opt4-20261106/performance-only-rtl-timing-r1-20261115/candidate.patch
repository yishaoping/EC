+#!/usr/bin/env python3
+"""Bounded independent two-CPU source/cycle checks; never launches full CAD."""
+import datetime as dt
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+C=Path(__file__).resolve().parent
+T=C.parent.parent
+R=Path('/data1/gzh/EC/Experiment/firesim-final-opt4-20261106')
+O=Path('/var/tmp/guozh-ec-rtl-timing-r1-20261115')
+REL='chipyard/generators/rocket-chip/src/main/scala/guardiancouncil/GH_FIFO.scala'
+
+def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
+def save(status,**kw):
+    s=dict(status=status,utc=dt.datetime.now(dt.timezone.utc).isoformat(),
+       profile='EC Performance-Only',full_shell_CAD=False,fpga_access=False,**kw)
+    (O/'state.json').write_text(json.dumps(s,indent=2)+'\n')
+def run(name,args,timeout=1200):
+    with (O/(name+'.log')).open('xb') as log:
+        r=subprocess.run(list(map(str,args)),cwd=O,stdout=log,stderr=subprocess.STDOUT,
+            stdin=subprocess.DEVNULL,timeout=timeout,
+            env={k:v for k,v in os.environ.items() if k not in ['PYTHONHOME','PYTHONPATH','LD_LIBRARY_PATH','LD_PRELOAD','JAVA_TOOL_OPTIONS']})
+    assert r.returncode==0,(name,r.returncode)
+    return O/(name+'.log')
+
+def main():
+    os.sched_setaffinity(0,{248,249});os.nice(10)
+    O.mkdir(exist_ok=False)
+    cfg=json.loads((T.parent/'candidates/common-composed-source-r2-20261113/config.json').read_text())
+    base=R/'build-logs/Opt4-performance-only-fpga-r1-20261113/classes'
+    cp=':'.join([str(base),cfg['firechip'],*cfg['classpath']])
+    classes=O/'classes';classes.mkdir();target=O/'target';target.mkdir()
+    java=[cfg['java'],'-Xmx8G','-Xss16M','-XX:ActiveProcessorCount=2','-Dec.dac.firesim=true']
+    save('COMPILING',source_sha256=sha(T/REL))
+    run('compile',java+['-cp',':'.join(cfg['compiler']),'scala.tools.nsc.Main','-classpath',cp,
+        '-Xplugin:'+cfg['plugin'],'-d',classes,T/REL,C/'Reference.scala',C/'Emit.scala'])
+    run('emit',java+['-cp',str(classes)+':'+cp,'ectiming.Emit',target])
+    save('CHECKING_ALL_OUTPUTS_TARGET_CYCLES',source_sha256=sha(T/REL))
+    run('verilate',['/usr/local/bin/verilator','--cc','--exe','--build','-j','2','-Wno-fatal',
+        '--top-module','QueuePair','--Mdir',O/'obj',target/'QueuePair.v',C/'compare.cpp'])
+    log=run('cycle',[O/'obj/VQueuePair'])
+    assert 'BJL_FIFO_ALL_OUTPUTS_CYCLE_PASS' in log.read_text()
+    save('PASS_CYCLE_COMPARISON_FORMAL_AND_SYNTH_PENDING',source_sha256=sha(T/REL),
+         rtl_sha256=sha(target/'QueuePair.v'),cycle=log.read_text().strip())
+
+if __name__=='__main__':
+    try:main()
+    except Exception as exc:
+        if O.exists():save('FAILED_WITH_EVIDENCE',error=repr(exc))
+        raise
