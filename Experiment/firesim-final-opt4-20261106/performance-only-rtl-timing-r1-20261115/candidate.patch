+def run(name,args,env,marker=None,negative=False,timeout=1200):
+    with (H/(name+'.log')).open('xb') as f:
+        p=subprocess.run(list(map(str,args)),cwd=H,stdin=subprocess.DEVNULL,
+            stdout=f,stderr=subprocess.STDOUT,env=env,timeout=timeout)
+    text=(H/(name+'.log')).read_text(errors='replace')
+    assert (p.returncode==0)!=negative,(name,p.returncode)
+    assert marker is None or marker in text,(name,'missing marker')
+    return text
+
+def main():
+    os.sched_setaffinity(0,{248,249});os.nice(19)
+    resume=len(sys.argv)>2 and sys.argv[2]=='--resume-build'
+    H.mkdir(exist_ok=resume)
+    env={k:v for k,v in os.environ.items() if k not in ['PYTHONHOME','PYTHONPATH',
+        'LD_LIBRARY_PATH','LD_PRELOAD','JAVA_TOOL_OPTIONS']}
+    cfg=json.loads((T.parent/'candidates/common-composed-source-r2-20261113/config.json').read_text())
