+    xci=[root/('firesim.srcs/'+ip+'/design_1_ddr4_0_0.xci') for root in [native,current]]
+    a,b=map(params,xci)
+    delta={k:[a.get(k),b.get(k)] for k in a.keys()|b.keys() if a.get(k)!=b.get(k)}
+    assert len(a)==len(b)==138 and not delta
+    for n in inventories['Native']:
+        assert len({v[n]['sha256'] for v in inventories.values()})==1
+    result=dict(profile='EC Performance-Only independent RTL timing candidate',
+        ddr_sources=inventories,ddr_xci=[dict(file=str(p),sha256=sha(p)) for p in xci],
