// Golden Gate-generated Verilog Header
// This file encodes variable width fields used in MIDAS-level simulation
// and is not used in FPGA compilation flows.
`ifndef __FIRESIM_H
`define __FIRESIM_H

// Simulation Constants
`define CTRL_ID_BITS 12
`define CTRL_ADDR_BITS 25
`define CTRL_DATA_BITS 32
`define CPU_MANAGED_AXI4_ID_BITS 6
`define CPU_MANAGED_AXI4_ADDR_BITS 64
`define CPU_MANAGED_AXI4_DATA_BITS 512
`define CPU_MANAGED_AXI4_PRESENT 1
`define MEM_HAS_CHANNEL-1 1
`define MEM_HAS_CHANNEL0 1
`define MEM_ID_BITS 16
`define MEM_ADDR_BITS 34
`define MEM_DATA_BITS 64
`endif  // __FIRESIM_H
